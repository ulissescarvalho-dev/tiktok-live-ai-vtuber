VOICE_WORKDIR=C:\caminho\para\Applio\data\runtime
APPLIO_APP_DIR=C:\caminho\para\Applio\app
RVC_MODEL_PTH=C:\caminho\para\seu\modelo.pth
AUDIO_DEVICE=CABLE Input

# Configurações de Animação 3D (VMC / VSeeFace)
