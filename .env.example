# Configurações da IA Local (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=llama3.2:1b
OLLAMA_MAX_TOKENS=35
OLLAMA_TEMPERATURA=0.7

# Configurações do Motor de Voz (Python + RVC na GPU)
PYTHON_EXE=C:\caminho\para\seu\.venv\Scripts\python.exe
